# Copy this to .streamlit/secrets.toml and fill in your values for local Streamlit runs.
# For Streamlit Cloud: paste these keys into App Settings → Secrets in the dashboard.
# NEVER commit secrets.toml with real values.

NEO4J_URI = "neo4j+s://your-instance.databases.neo4j.io"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "your_neo4j_password"
NEO4J_DATABASE = "your_database_name"
ANTHROPIC_API_KEY = "your_anthropic_api_key"
CLAUDE_MODEL = "claude-sonnet-4-6"
BUDGET_OVERRUN_PCT = "15"
LARGE_TRANSACTION_ZAR = "50000"
OVERDUE_GRACE_DAYS = "0"
