# Neo4j Aura Configuration
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=your_database_name

# Optional Aura metadata (if using Neo4j Aura)
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=your_instance_name

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# Thresholds for anomaly detection
BUDGET_OVERRUN_PCT=15          # % over budget to flag
LARGE_TRANSACTION_ZAR=50000    # flag as "large" for review
OVERDUE_GRACE_DAYS=0            # days past due before "overdue"

# Memory Settings
MEMORY_CONVERSATION_MAX_HISTORY=100    # Max conversation messages to keep
MEMORY_REASONING_PERSIST_FILE=reasoning_traces.json  # File for reasoning traces
MEMORY_CONVERSATION_PERSIST_FILE=conversation_history.json  # File for conversation history
MEMORY_ENABLE_NEO4J_STORAGE=true  # Store reasoning traces in Neo4j
MEMORY_ENABLE_REASONING=false  # Enable reasoning traces by default
